# Configuración de MongoDB (Cloud/Atlas)
SPRING_DATA_MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority

# Configuración de Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Configuración de Correo (Gmail App Password)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# Correo de recuperación por HTTPS (ambas variables vacías para usar SMTP)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
APP_BASE_URL=http://localhost:8080

# API Keys
GEMINI_API_KEY=your_gemini_api_key

# Google OAuth2
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Microservicio Machine Learning (FastAPI en Render)
PREDICCION_API_URL=https://tu-servicio-python.onrender.com


