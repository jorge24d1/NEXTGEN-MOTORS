# =============================================
# MCP DBHub Server — HTTP/SSE Mode
# @bytebase/dbhub es un paquete npm puro (Node.js)
# No requiere binario Go ni multi-stage
# =============================================
FROM node:20-alpine

WORKDIR /app

# Instalar supergateway + @bytebase/dbhub desde npm
# mysql2 viene incluido como dependencia de @bytebase/dbhub
RUN npm install -g supergateway @bytebase/dbhub

EXPOSE 3002

# DSN se inyecta como variable de entorno en Render
ENV DSN=""

# supergateway arranca dbhub (npm) en stdio internamente y
# expone el protocolo MCP como SSE en el puerto 3002.
# Usamos sh -c para que $DSN se expanda en runtime.
ENTRYPOINT ["sh", "-c", "supergateway --port 3002 --stdio \"dbhub --dsn $DSN\""]

